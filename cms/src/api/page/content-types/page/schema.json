{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "name": "page",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "shortName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "contentSections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.launches",
        "sections.developments",
        "sections.communities",
        "sections.showcase",
        "sections.legacy",
        "sections.press",
        "sections.converse",
        "sections.about-masthead",
        "sections.contact-masthead",
        "sections.faq-section",
        "sections.bottom-actions",
        "sections.feature-columns-group",
        "sections.feature-rows-group",
        "sections.testimonials-group",
        "sections.large-video",
        "sections.rich-text",
        "sections.pricing",
        "sections.lead-form",
        "sections.features",
        "sections.heading",
        "sections.property-detail",
        "sections.navbar",
        "sections.search-filter",
        "sections.contact-reach",
        "sections.contact-form",
        "sections.contact-offices",
        "sections.contact-teams",
        "sections.related-links",
        "sections.about-founder",
        "sections.about-record",
        "sections.about-businesses",
        "sections.about-international",
        "sections.about-leadership",
        "sections.about-awards",
        "sections.about-responsibility",
        "sections.property-overview",
        "sections.property-highlights",
        "sections.property-amenities",
        "sections.property-gallery",
        "sections.property-connectivity",
        "sections.property-location",
        "sections.thank-you"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "type": "string",
      "regex": "^$|^[a-zA-Z/-]+$"
    },
    "heading": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "description": {
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "type": "string"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "shared.seo"
    }
  }
}
